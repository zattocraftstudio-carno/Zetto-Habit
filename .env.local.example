# Supabase (SERVER-ONLY — never add a NEXT_PUBLIC_ prefix to these)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth
SESSION_JWT_SECRET=your-random-jwt-secret-here

# AI Agent (OpenRouter backend chain — fixed in code, auto-switched)
OPENROUTER_API_KEY=your-openrouter-key

# AI Agent (Groq primary provider)
GROQ_API_KEY=your-groq-key
GROQ_MODEL_MAIN=openai/gpt-oss-120b
